DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_DATABASE=hr_system
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Chấm công bằng khuôn mặt (mô phỏng, mặc định tắt)
FACE_ENABLED=0
FACE_ENGINE=auto
FACE_EMBEDDING_THRESHOLD=0.80
FACE_HASH_THRESHOLD=0.90
FACE_MAX_UPLOAD_BYTES=5242880
FACE_MAX_ENROLL_IMAGES=5
FACE_AUTO_CAPTURE_SECONDS=4
FACE_ENROLL_INTERVAL_SECONDS=3
